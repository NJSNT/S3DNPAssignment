@page "/login"
@using BlazorApp.Auth
@inject SimpleAuthProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Account</h1>
        <p>You are logged in as <strong>@context.User.Identity?.Name</strong>.</p>
        <button class="btn btn-outline-danger" type="button" @onclick="LogoutAsync">Log out</button>
    </Authorized>
    <NotAuthorized>
        <h1>Login</h1>

        <div class="mb-3">
            <label class="form-label">Username</label>
            <input class="form-control" autocomplete="username" @bind="userName" />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input class="form-control" type="password" autocomplete="current-password" @bind="password" />
        </div>

        <button class="btn btn-primary" type="button" disabled="@isSubmitting" @onclick="LoginAsync">Log in</button>

        @if (error is not null)
        {
            <p class="text-danger mt-3">@error</p>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    private string userName = "";
    private string password = "";
    private string? error;
    private bool isSubmitting;

    private async Task LoginAsync()
    {
        if (isSubmitting)
        {
            return;
        }

        error = null;
        isSubmitting = true;

        try
        {
            await AuthProvider.LoginAsync(userName, password);
            Navigation.NavigateTo("/");
        }
        catch (Exception exception)
        {
            error = exception.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LogoutAsync()
    {
        await AuthProvider.LogoutAsync();
        Navigation.NavigateTo("/");
    }
}
